FROM debian:bookworm-slim AS libredwg
RUN apt-get update && apt-get install -y --no-install-recommends build-essential pkg-config curl ca-certificates xz-utils
WORKDIR /build
RUN curl -fL --retry 3 https://github.com/LibreDWG/libredwg/releases/download/0.14/libredwg-0.14.tar.xz -o source.tar.xz \
    && echo '62ebb73b984f865960f20ed26619ea5f8789d5e3fd088fa40a2598384da81275  source.tar.xz' | sha256sum -c - \
    && tar -xf source.tar.xz \
    && cd libredwg-0.14 \
    && ./configure --prefix=/opt/libredwg --disable-bindings --disable-python --disable-docs --disable-shared \
    && make -j2 && make install-strip \
    && mkdir -p /opt/libredwg/share/licenses \
    && cp COPYING /opt/libredwg/share/licenses/COPYING \
    && rm -rf /opt/libredwg/include /opt/libredwg/lib /opt/libredwg/share/info \
              /opt/libredwg/share/man /opt/libredwg/share/doc

FROM python:3.12-slim-bookworm
COPY --from=libredwg /opt/libredwg /opt/libredwg
ENV LIBREDWG_BIN=/opt/libredwg/bin LIBREDWG_TIMEOUT_SECONDS=15
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 ENGINEERING_RUNTIME=cloud ENGINEERING_SERVICE_ROLE=engineering PORT=80 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 QT_QPA_PLATFORM=offscreen
RUN apt-get update && apt-get install -y --no-install-recommends \
    libglib2.0-0 libgomp1 libgl1 libx11-6 libxext6 libxrender1 fonts-wqy-zenhei \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements-native.txt ./
RUN pip install --no-cache-dir -r requirements-native.txt \
    && pip install --no-cache-dir --no-deps rapidocr-onnxruntime==1.4.4 \
    && find /usr/local/lib/python3.12/site-packages -type d \
       \( -name tests -o -name test \) -prune -exec rm -rf '{}' + \
    && find /usr/local/lib/python3.12/site-packages -type d -name __pycache__ -prune -exec rm -rf '{}' +
RUN python -c "from OCP.BRepPrimAPI import BRepPrimAPI_MakeCylinder; assert not BRepPrimAPI_MakeCylinder(10, 30).Shape().IsNull()"
COPY server ./server
RUN python -c "import server.native_entry; import server.cad_artifacts; import server.evidence"
COPY scripts/cloud_native_smoke.py ./scripts/cloud_native_smoke.py
RUN /opt/libredwg/bin/dwg2dxf --version && /opt/libredwg/bin/dxf2dwg --version
RUN useradd --create-home engineer
USER engineer
EXPOSE 80
CMD ["python", "-m", "server.native_entry"]
