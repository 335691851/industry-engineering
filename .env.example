DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_TEXT_MODEL=deepseek-flash

# Local CPU OCR: auto (default) or off. No remote OCR key required.
ENGINEERING_OCR=auto
# Optional independent vision provider (all three required together).
ENGINEERING_VISION_BASE_URL=
ENGINEERING_VISION_API_KEY=
ENGINEERING_VISION_MODEL=

# Optional LibreDWG executable directory; cloud container sets /opt/libredwg/bin.
LIBREDWG_BIN=
