{
  "services": {
    "web": {"root":"web", "framework":null, "installCommand":"", "buildCommand":"", "outputDirectory":".", "rewrites":[{"source":"/((?!assets/|cad-assets/|cad-studio.html).*)","destination":"/index.html"}]},
    "backend": {"root":"backend", "runtime":"container", "entrypoint":"Dockerfile.vercel", "functions":{"Dockerfile.vercel":{"maxDuration":800,"memory":4096}}, "bindings":[{"type":"service","service":"orchestrator","format":"url","env":"ENGINEERING_ORCHESTRATOR_URL"}]},
    "orchestrator": {"root":"orchestrator", "framework":"nextjs", "functions":{"app/**/*.js":{"maxDuration":800,"memory":2048}}, "bindings":[{"type":"service","service":"backend","format":"url","env":"ENGINEERING_BACKEND_URL"}]}
  },
  "rewrites":[
    {"source":"/.well-known/workflow/(.*)","destination":{"service":"orchestrator"}},
    {"source":"/api/cloud/reconcile","destination":{"service":"orchestrator"}},
    {"source":"/api/(.*)","destination":{"service":"backend"}},
    {"source":"/(.*)","destination":{"service":"web"}}
  ],
  "crons":[{"path":"/api/cloud/reconcile","schedule":"*/5 * * * *"}]
}
