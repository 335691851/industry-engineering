# Set as SERVER environment variables in the Vercel project, never VITE_*.
ENGINEERING_RUNTIME=cloud
ENGINEERING_TASK_PROVIDER=vercel
ENGINEERING_TASK_TIMEOUT_SECONDS=600
ENGINEERING_APP_ORIGIN=https://YOUR-PROJECT.vercel.app
ENGINEERING_SERVICE_TOKEN=
CRON_SECRET=
SUPABASE_URL=https://YOUR-REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
# Direct connection or Session pooler (5432), SSL required; not Transaction pooler (6543).
SUPABASE_DB_URL=
SUPABASE_STORAGE_BUCKET=engineering-private
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_TEXT_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
ENGINEERING_OCR=auto
# ENGINEERING_BACKEND_URL / ENGINEERING_ORCHESTRATOR_URL are injected by service bindings.
