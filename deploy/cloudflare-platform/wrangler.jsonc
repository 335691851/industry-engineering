{
 "$schema":"node_modules/wrangler/config-schema.json",
 "name":"engineering-platform",
 "main":"src/index.ts",
 "compatibility_date":"2026-09-28",
 "compatibility_flags":["nodejs_compat"],
 "observability":{"enabled":true},
 "triggers":{"crons":["*/5 * * * *"]},
 "vars":{"SUPABASE_URL":"","SUPABASE_PUBLISHABLE_KEY":"","ENGINEERING_APP_ORIGIN":"","CLOUDFLARE_DISPATCH_URL":"","SUPABASE_STORAGE_BUCKET":"engineering-private","PYTHON_BACKEND_URL":""},
 "containers":[{"class_name":"EngineeringRuntime","image":"../../Dockerfile.cloud","max_instances":2,"instance_type":"standard-2"}],
 "durable_objects":{"bindings":[{"name":"ENGINEERING_RUNTIME","class_name":"EngineeringRuntime"}]},
 "migrations":[{"tag":"v1","new_sqlite_classes":["EngineeringRuntime"]}],
 "workflows":[{"name":"engineering-business","binding":"ENGINEERING_TASKS","class_name":"EngineeringTask"}]
}
